{
  "name": "cn-trials",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:server": "npm run dev -w @cn-trials/server",
    "dev:web": "npm run dev -w @cn-trials/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "build": "npm run build -w @cn-trials/web",
    "test:load": "node tests/load/thirty-clients.mjs",
    "test:e2e": "node tests/e2e/two-browsers.mjs"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "colyseus.js": "^0.16.22",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
