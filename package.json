{
  "name": "cn-trials",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:server": "wrangler dev --port 8787",
    "dev:web": "npm run dev -w @cn-trials/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "build": "npm run build -w @cn-trials/web",
    "test:load": "tsx tests/load/thirty-clients.mjs",
    "test:e2e": "tsx tests/e2e/two-browsers.mjs",
    "test:quality": "tsx tests/e2e/quality.mjs",
    "test:obstacles": "tsx tests/integration/obstacles.mjs",
    "test:ui": "tsx tests/e2e/ui.mjs",
    "test:thirty": "tsx tests/e2e/thirty.mjs",
    "deploy": "npm run build && wrangler deploy",
    "test:round": "tsx tests/integration/round.mjs",
    "test:colorways": "tsx tests/integration/colorways.mjs",
    "test:contestant-perf": "tsx tests/e2e/contestant-perf.mjs",
    "test:measure": "tsx tests/e2e/refinement-measure.mjs",
    "test:second-pass": "tsx tests/e2e/second-pass.mjs"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.7",
    "wrangler": "4.158.0"
  }
}
